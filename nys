#!/bin/bash

# CONFIG ---------------------------------------------------------------------------------------------------------------

# yt-dlp target release channel ('stable'/'nightly'/'master', or '' to disable)
# (see https://github.com/yt-dlp/yt-dlp#update for more info)
releaseChannel=""

# target configurations (yt-dlp runs once for each configuration)
declare -a configurations=("soundcloud/albums" "soundcloud/tracks" "soundcloud/playlists")

# download subdirectories ([CONFIGURATION]=SUBDIRECTORY)
declare -A downloadSubdirectories=(
    ["soundcloud/albums"]="soundcloud"
    ["soundcloud/tracks"]="soundcloud"
    ["soundcloud/playlist"]="soundcloud"
    ["youtube"]="youtube"
)

# directory paths
declare -a logFileDirectories=("logs")                # contains log files
declare -a configurationBackupDirectories=("backups") # contains configuration backup files
configurationsDirectory="configurations"              # contains all configuration directories
downloadsDirectory="downloads"                        # contains successful downloads, hashes and infodicts

# filename templates (resolved using printf)
logFileBasename="nys-log.txt"                         # template to use for log filenames
timestampTemplate="[%(%Y-%m-%d)T]"                    # template to use for timestamps appended to filenames

# file retention counts (max # of files saved)
configFileBackupRetentionCount=30                     # retention count for config backup files
logFileRetentionCount=30                              # retention count for log files

# ----------------------------------------------------------------------------------------------------------------------

# change present working directory to this script's location
cd "$(dirname ${BASH_SOURCE[0]})"

# create log directories if they don't exist
mkdir -p "${logFileDirectories[@]}"

# printf the log file template and save it (-1 indicates explicit current date, not shell start time)
if [[ $logFileBasename == *"."* ]]; then
    printf -v "logFileNameWithTimestamp" ""${logFileBasename%.*}" "$timestampTemplate"."${logFileBasename##*.}"" -1
else
    printf -v "logFileNameWithTimestamp" ""$logFileBasename" "$timestampTemplate"" -1
fi

# declare log file paths
declare -a logFiles=("${logFileDirectories[@]/%//$logFileNameWithTimestamp}")

# update yt-dlp if enabled (requires running script with root/admin permissions)
if [ "${releaseChannel,,}" = "stable" ] || [ "${releaseChannel,,}" = "nightly" ] \
    || [ "${releaseChannel,,}" = "master" ]; then

    # yt-dlp update command
    yt-dlp --update-to "${releaseChannel,,}" 2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1

elif [ -n "$releaseChannel" ]; then

    # log error and exit if release channel is invalid
    echo "release channel '$releaseChannel' does not exist, check script config and re-run" \
        2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1
    exit 1

fi

# iterate through configuration files
for configuration in "${configurations[@]}";
do

    # initialize filepaths
    configurationDirectory="$configurationsDirectory/$configuration"
    downloadsSubdirectory="${downloadSubdirectories["$configuration"]}"

    # yt-dlp execution time as # of seconds since epoch
    ytDlpTimestamp="$(date "+%s")"

    # yt-dlp command
    yt-dlp --paths "$downloadsDirectory/$downloadsSubdirectory" --config-locations "$configurationDirectory" \
        2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1

    # hash downloaded files
    find "$downloadsDirectory/$downloadsSubdirectory" \
        -type f -not -name "*.md5" -newermt "@$ytDlpTimestamp" \
        -exec sh -c "md5sum \"\$1\" | tee \"\$1.md5\"" -- "{}" \; \
        2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1

    # back up any changed configuration files
    for configurationBackupDirectory in "${configurationBackupDirectories[@]}";
    do

        # read all config files into array (%P removes leading directory path, -d "" splits array on null chars)
        mapfile -d "" configFiles < <(find "$configurationsDirectory" -type f -printf "%P\0")

        # back up config files if they changed since last backups were saved
        for configFile in "${configFiles[@]}";
        do
            # config file name/directory
            configFileName="$(basename "$configFile")"
            configFileDirectory="$(dirname "$configFile")"

            # create target backup directory if it doesn't exist
            mkdir -p "$configurationBackupDirectory/$configFileDirectory"

            # get the most recent config file backup
            newestConfigFileBackup="$(find "$configurationBackupDirectory/$configFileDirectory" \
                -maxdepth 1 -name "${configFileName%.*}*" -type f -printf "%T@ %p\n" \
                | sort -n | cut -d' ' -f 2- | tail -n 1)"

            # if there is no backup, or if it differs from current config file, create new backup
            if [ -z "$newestConfigFileBackup" ] || \
                ! cmp -s "$newestConfigFileBackup" "$configurationsDirectory/$configFile"; then

                # if filename contains file extension, add timestamp before extension
                if [[ "$configFileName" == *"."* ]]; then
                    printf -v "configFileWithTimestamp" ""${configFile%.*}" "$timestampTemplate"."${configFile##*.}"" -1
                else
                    printf -v "configFileWithTimestamp" ""$configFile" "$timestampTemplate"" -1
                fi

                # copy the current config file to the backup directory
                cp -v "$configurationsDirectory/$configFile" "$configurationBackupDirectory/$configFileWithTimestamp" \
                    2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1
                    
            fi
            
        done

        # count configuration backups
        configFileBackupCount="$(find "$configurationBackupDirectory/$configFileDirectory" \
            -maxdepth 1 -name "${configFileName%.*}*" -type f | wc -l)"

        # if the number of config backups is higher than retention count, delete oldest backups
        while [ "$configFileBackupCount" -gt "$configFileBackupRetentionCount" ]; do

            # get oldest backup file
            oldestConfigFileBackup="$(find "$configurationBackupDirectory*" \
                -maxdepth 1 -type d -printf "%T@ %p\n" | sort -n | cut -d' ' -f 2- | head -n 1)"

            # remove oldest backup file and decrement count
            rm -frv "$oldestConfigFileBackup" 2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1
            ((configurationBackupCount--))

        done

    done

done

# remove oldest log file if log file count is over log file retention count
for pathToLogFilesDirectory in "${logFileDirectories[@]}";
do

    # count number of log files
    logFileCount="$(find "$pathToLogFilesDirectory" -maxdepth 1 -type f -not -name ".gitignore" | wc -l)"

    # if the number of log files is higher than retention count, delete oldest log files
    while [ "$logFileCount" -gt "$logFileRetentionCount" ]; do

        # get oldest log file
        oldestLogFile="$(find "$pathToLogFilesDirectory" -maxdepth 1 -type f -printf "%T@ %p\n" \
            | sort -n | cut -d' ' -f 2- | head -n 1)"

        # remove oldest log file and decrement count
        rm -v -f "$oldestLogFile" 2>&1 | ts 2>&1 | tee -a "${logFiles[@]}" 2>&1
        ((logFileCount--))

    done

done
